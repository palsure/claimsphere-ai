# Baidu AI Studio API Configuration
# Get your API keys from: https://aistudio.baidu.com
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000

# Database Configuration
# For development: SQLite (default)
# For production: PostgreSQL
DATABASE_URL=sqlite:///./claimsphere.db
# DATABASE_URL=postgresql://user:password@localhost:5432/claimsphere

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR Configuration
DISABLE_MODEL_SOURCE_CHECK=True

# CAMEL-AI Model Configuration
# Option 1: OLLAMA (Free, Local, Open-Source - Recommended)
# Set USE_OLLAMA=true to enable OLLAMA (default: true)
USE_OLLAMA=true
# OLLAMA runs in Docker, no API key needed
# Default: http://ollama:11434 (Docker network) or http://localhost:11434 (local)
OLLAMA_BASE_URL=http://ollama:11434

# Option 2: OpenAI (Cloud-based)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option 3: Qianfan Platform (Alternative)
# Get your API key from: https://console.bce.baidu.com/qianfan/overview
# Note: Qianfan Platform may be different from Baidu AI Studio
# The API key should start with "ak-" (e.g., ak-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
QIANFAN_API_KEY=
